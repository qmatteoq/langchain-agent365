{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug LangChain Agent Host",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/start_with_generic_host.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        }
    ]
}